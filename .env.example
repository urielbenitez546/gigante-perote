# Copia este archivo como ".env" (en la raíz del proyecto) y llena los valores
# reales que obtienes de tu proyecto de Supabase (Settings > API).
#
# VITE_SUPABASE_URL es la "Project URL".
# VITE_SUPABASE_ANON_KEY es la clave pública "anon public" (NO la "service_role").
#
# Estas dos variables son seguras de exponer en el frontend: la seguridad real
# se aplica con políticas RLS en la base de datos, no ocultando esta clave.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
